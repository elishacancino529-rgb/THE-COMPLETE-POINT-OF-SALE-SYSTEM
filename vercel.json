    { "src": "/mercedes-gls.webp", "dest": "/public/mercedes-gls.webp" },
    { "src": "/mercedes-eqe.webp", "dest": "/public/mercedes-eqe.webp" },
    { "src": "/mercedes-eqs.webp", "dest": "/public/mercedes-eqs.webp" },
    { "src": "/mercedes-amg-gt.webp", "dest": "/public/mercedes-amg-gt.webp" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
