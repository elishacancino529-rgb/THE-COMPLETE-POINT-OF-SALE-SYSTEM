{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.6.2" }
  },
  "routes": [
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/viewer.js", "dest": "/public/viewer.js" },
    { "src": "/three.module.js", "dest": "/public/three.module.js" },
    { "src": "/three.core.js", "dest": "/public/three.core.js" },
    { "src": "/OrbitControls.js", "dest": "/public/OrbitControls.js" },
    { "src": "/favicon.svg", "dest": "/public/favicon.svg" },
    { "src": "/mercedes-login.webp", "dest": "/public/mercedes-login.webp" },
    { "src": "/mercedes-s-class.webp", "dest": "/public/mercedes-s-class.webp" },
    { "src": "/mercedes-e-class.webp", "dest": "/public/mercedes-e-class.webp" },
    { "src": "/mercedes-g-class.webp", "dest": "/public/mercedes-g-class.webp" },
    { "src": "/mercedes-c-class.webp", "dest": "/public/mercedes-c-class.webp" },
    { "src": "/mercedes-a-class.webp", "dest": "/public/mercedes-a-class.webp" },
    { "src": "/mercedes-cla.webp", "dest": "/public/mercedes-cla.webp" },
    { "src": "/mercedes-cle.webp", "dest": "/public/mercedes-cle.webp" },
    { "src": "/mercedes-gla.webp", "dest": "/public/mercedes-gla.webp" },
